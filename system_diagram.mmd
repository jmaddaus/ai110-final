flowchart TB
    User([User picks seed song<br/>+ adjusts sliders]):::human
    UI[Streamlit Web UI<br/>seed input]

    User --> UI

    subgraph Retriever [Retriever]
        direction LR
        Catalog[(Catalog<br/>81k Spotify tracks<br/>9 audio features)]
        LFArtist[(Last.fm artist cache<br/>tags + similar artists)]
        LFTrack[(Last.fm track-tag cache<br/>per-song descriptors)]
        Embed[(Vertex AI embedding cache<br/>16k artist vectors)]
        MB[(MusicBrainz cache<br/>member instruments)]
    end

    UI --> Retriever

    subgraph Engine [Similarity Engine]
        direction TB
        Pool[Audio cosine pool<br/>top 5k or 20k candidates]
        Pool --> Blend[Blend 6 signals:<br/>audio cosine, IDF tag Jaccard,<br/>track-tag Jaccard, embedding cosine,<br/>match-weighted Last.fm bonus,<br/>popularity bucket]
        Blend --> Diversify[Diversify by artist]
    end

    Retriever --> Engine

    subgraph Evaluator [Evaluator]
        Conf[Confidence rating<br/>high / medium / low]
    end

    Engine --> Evaluator

    subgraph Generator [RAG Generator]
        direction LR
        Context[Build context block:<br/>features, tags, scores]
        Gemini[Gemini gemini-3-flash-preview<br/>grounded explanation]
        Context --> Gemini
    end

    Evaluator --> Generator

    Output[Streamlit result cards<br/>scores + tags + radar + explanation]:::output
    Generator --> Output
    Output --> Reader([User reads results<br/>+ confidence badge]):::human

    subgraph Tester [Tester]
        direction LR
        Unit[Unit tests<br/>pytest, 27 cases]:::test
        Shots[Playwright A/B<br/>screenshots]:::test
    end

    Tester -. validates .-> Engine
    Tester -. validates .-> Output

    classDef human fill:#fef3c7,stroke:#92400e,stroke-width:2px
    classDef test fill:#dbeafe,stroke:#1e3a8a,stroke-width:1px
    classDef output fill:#dcfce7,stroke:#14532d,stroke-width:2px
